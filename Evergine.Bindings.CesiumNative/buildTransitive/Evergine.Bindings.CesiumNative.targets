<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!--
	  browser-wasm has no dynamic loading, so runtimes/browser-wasm/native is not probed at
	  run time the way the desktop identifiers are: the archive has to be linked into the
	  application when it publishes. That is what this does, and without it the package would
	  carry the library and no consumer would ever link it.

	  ScanForPInvokes is what makes the DllImports resolve. It has the build read the managed
	  assembly's P/Invokes and emit the table the runtime looks them up in; the reference alone
	  puts the code in the module and leaves every call unresolved.

	  The archive is packed as CesiumNativeC.a rather than the libCesiumNativeC.a that CMake
	  produces, because the module name comes from the file name and the DllImports say
	  "CesiumNativeC". Evergine.Bindings.Imgui ships cimgui.a against DllImport("cimgui") and
	  Evergine's ktx.a does the same; both work, and neither carries a lib prefix.
	-->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
		<NativeFileReference Include="$(MSBuildThisFileDirectory)../runtimes/browser-wasm/native/CesiumNativeC.a"
		                     ScanForPInvokes="true" />
	</ItemGroup>

	<!--
	  iOS is linked rather than loaded too, and for a different reason: Apple only lets an
	  application load dynamic libraries that ship inside its own bundle as frameworks. So
	  CesiumC builds a static archive there and this links it into the application.

	  Kind=Static and not Framework, which is where this parts company with
	  Evergine.Bindings.Vuforia. Vuforia ships a dynamic VuforiaEngine.framework and has to copy
	  it into the bundle afterwards; an archive is linked and does not travel, so none of that
	  applies here.

	  ForceLoad is on, and both settings were tried against a real link before this one stayed.

	  Without it the linker keeps only the members something references, and every entry point
	  here is reached from managed code rather than from native. The application built, weighed
	  30 MB, and did not define cesium_async_system_create at all: the member carrying it had
	  been dropped. A P/Invoke into it would have failed on a device, in somebody else's app,
	  long after every build went green.

	  With it, the link used to die on duplicate symbols, because the archive carried libjpeg.a
	  beside libturbojpeg.a and libwebpdecoder.a beside libwebp.a. That is fixed where it
	  belonged, in the merge in CesiumC, which no longer takes archives nothing links.

	  The package smoke test is what turned this from an argument into a measurement: it reads
	  the built executable and fails if cesium_async_system_create is not among its defined
	  symbols, which is exactly how the dropped member was found.

	  Which runtime identifier to pick is decided by the platform rather than by
	  $(RuntimeIdentifier), unlike the wasm block above: an iOS build may be for a device or for
	  the simulator, they are different architectures, and only $(RuntimeIdentifier) says which.
	-->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<_CesiumNativeIosRid Condition="'$(_CesiumNativeIosRid)' == ''">$(RuntimeIdentifier)</_CesiumNativeIosRid>
		<_CesiumNativeIosRid Condition="'$(_CesiumNativeIosRid)' == ''">ios-arm64</_CesiumNativeIosRid>
		<_CesiumNativeIosArchive>$(MSBuildThisFileDirectory)../runtimes/$(_CesiumNativeIosRid)/native/libCesiumNativeC.a</_CesiumNativeIosArchive>
	</PropertyGroup>

	<Target Name="EvergineCesiumNativeAddIosNativeReference"
	        BeforeTargets="_ComputeLinkNativeExecutableInputs"
	        Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And Exists('$(_CesiumNativeIosArchive)')">
		<ItemGroup>
			<_FrameworkNativeReference Include="$(_CesiumNativeIosArchive)">
				<Kind>Static</Kind>
				<ForceLoad>true</ForceLoad>
				<SmartLink>false</SmartLink>
			</_FrameworkNativeReference>
		</ItemGroup>
	</Target>

</Project>
