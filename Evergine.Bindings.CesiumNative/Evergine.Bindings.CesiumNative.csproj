<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Copyright>Copyright (c) Evergine 2026</Copyright>
		<Authors>Evergine Team</Authors>
		<Company>Plain Concepts</Company>
		<Description>Low-level bindings for CesiumNative used in Evergine</Description>
		<RepositoryUrl>https://github.com/EvergineTeam/Cesium.NET</RepositoryUrl>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!--
		  Without this the package ships the assembly alone and every doc comment the generator
		  emits is invisible to whoever consumes it. That was not academic: the remark saying
		  AssetAccessorCallbacksSet does not work on browser-wasm was added, regenerated and
		  packed, and a consumer would still have seen nothing.

		  CS1591 is suppressed rather than answered. It asks for a comment on every public
		  member, and 604 of them are generated from C headers that carry no documentation for
		  the generator to copy. Silencing it keeps the comments that do exist useful instead of
		  drowning the build in warnings about the ones that cannot.
		-->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Folder Include="Generated\" />
	</ItemGroup>

	<ItemGroup>
		<!-- The wasm archive is packed separately, under the name the DllImports use. -->
		<Content Include="runtimes\**"
				 Exclude="runtimes\browser-wasm\native\libCesiumNativeC.a"
				 PackagePath="runtimes"
				 Visible="true" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!--
	  browser-wasm links statically, and the module name a DllImport resolves against comes from
	  the file name. CMake produces libCesiumNativeC.a while every DllImport in Generated says
	  "CesiumNativeC", so the package renames it. Evergine.Bindings.Imgui ships cimgui.a against
	  DllImport("cimgui"), which is the same arrangement and is known to work.

	  Conditioned on the file existing because it does not: the seven libraries are fetched from
	  the CesiumC release the manifest records, so this is empty in a fresh clone and populated
	  in CI. Without the condition, packing before a fetch would fail on a missing file.
	-->
	<ItemGroup Condition="Exists('runtimes\browser-wasm\native\libCesiumNativeC.a')">
		<Content Include="runtimes\browser-wasm\native\libCesiumNativeC.a"
				 PackagePath="runtimes\browser-wasm\native\CesiumNativeC.a"
				 Visible="true" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="buildTransitive\Evergine.Bindings.CesiumNative.targets"
				 PackagePath="buildTransitive" Visible="true" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\icon.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>
