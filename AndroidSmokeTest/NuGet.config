<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Restores the package under test from a local folder rather than nuget.org, which is the
    whole point: this runs before anything is published, so the version it needs does not exist
    anywhere else yet.
  -->
  <packageSources>
    <clear />
    <add key="local" value="local-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
